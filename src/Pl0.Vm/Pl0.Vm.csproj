<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\TinyPl0.PackageVersion.props" />
  <ItemGroup>
    <ProjectReference Include="..\Pl0.Core\Pl0.Core.csproj" Version="[$(TinyPl0PackageVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TinyPl0.Vm</PackageId>
    <PackageVersion>$(TinyPl0PackageVersion)</PackageVersion>
    <Version>$(TinyPl0PackageVersion)</Version>
    <Authors>Thorsten Hindermann</Authors>
    <Description>Einbettbare, didaktische P-Code-VM des historischen PL/0 für .NET 10 mit vollständiger und schrittweiser Ausführung, Host-I/O und begrenzbaren Laufzeitressourcen. / Embeddable educational P-Code VM for historical PL/0 on .NET 10 with complete and stepwise execution, host I/O, and bounded runtime resources.</Description>
    <PackageTags>pl0;virtual-machine;vm;compiler-construction;p-code;education;teaching;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hindermath/TinyPl0</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\docs\nuget\TinyPl0.Vm.README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
