<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\TinyPl0.PackageVersion.props" />
  <ItemGroup>
    <ProjectReference Include="..\Pl0.Core\Pl0.Core.csproj" Version="[$(TinyPl0PackageVersion)]" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TinyPl0.Vm</PackageId>
    <PackageVersion>$(TinyPl0PackageVersion)</PackageVersion>
    <Version>$(TinyPl0PackageVersion)</Version>
    <Authors>Thorsten Hindermann</Authors>
    <Description>Embeddable PL/0 virtual machine for .NET 10 / Einbettbare PL/0-VM für .NET 10</Description>
    <PackageTags>pl0;virtual-machine;education;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hindermath/TinyPl0</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\docs\nuget\TinyPl0.Vm.README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
