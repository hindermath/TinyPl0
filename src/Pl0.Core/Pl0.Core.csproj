<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\TinyPl0.PackageVersion.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TinyPl0.Core</PackageId>
    <!--
      Beim Packen des VM-Projekts fragt NuGet die Core-Version mit deaktivierten
      Projektreferenzen ab. Die Bereichsschreibweise erzwingt dabei dieselbe Version.

      When packing the VM project, NuGet queries the Core version with project
      references disabled. The range notation pins that dependency to the same version.
    -->
    <PackageVersion Condition="'$(BuildProjectReferences)' != 'false'">$(TinyPl0PackageVersion)</PackageVersion>
    <PackageVersion Condition="'$(BuildProjectReferences)' == 'false'">[$(TinyPl0PackageVersion)]</PackageVersion>
    <Version>$(TinyPl0PackageVersion)</Version>
    <Authors>Thorsten Hindermann</Authors>
    <Description>Didaktischer Compilerkern des historischen PL/0 für .NET 10 mit Lexer, Parser, Diagnosen und typisierter P-Code-Erzeugung ohne Laufzeitabhängigkeiten. / Educational compiler core for historical PL/0 on .NET 10 with a lexer, parser, diagnostics, and typed P-Code generation without runtime dependencies.</Description>
    <PackageTags>pl0;compiler;compiler-construction;p-code;education;teaching;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hindermath/TinyPl0</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\docs\nuget\TinyPl0.Core.README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
