{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hindermath.github.io/TinyPl0/contracts/autonomous-gate-requirements-1.0.schema.json",
  "title": "TinyPl0 Autonomous Gate Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "feature",
    "runId",
    "owner",
    "reviewer",
    "evidenceContract",
    "gates"
  ],
  "properties": {
    "$schema": { "const": "./contracts/gate-requirements.schema.json" },
    "schemaVersion": { "const": "1.0" },
    "feature": { "const": "specs/004-secure-development-hardening" },
    "runId": { "const": "abaa7b81-fd2c-47e7-8d59-87a852a3b2e7" },
    "owner": { "$ref": "#/$defs/nonEmpty" },
    "reviewer": { "$ref": "#/$defs/nonEmpty" },
    "evidenceContract": { "const": "specs/004-secure-development-hardening/contracts/evidence-contract.md" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nonEmptyArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "emptyArray": {
      "type": "array",
      "maxItems": 0
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "applicability",
        "requiredScope",
        "exactCommands",
        "requiredCommandTokens",
        "requiredRunnerOrPlatformTokens",
        "evidencePath",
        "rationale",
        "reevaluationTrigger"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*-GATE-[0-9]{3}$"
        },
        "applicability": { "enum": ["Applicable", "N/A"] },
        "requiredScope": { "$ref": "#/$defs/nonEmpty" },
        "exactCommands": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "requiredCommandTokens": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "requiredRunnerOrPlatformTokens": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "evidencePath": { "$ref": "#/$defs/nonEmpty" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "reevaluationTrigger": { "$ref": "#/$defs/nonEmpty" }
      },
      "allOf": [
        {
          "if": { "properties": { "applicability": { "const": "Applicable" } }, "required": ["applicability"] },
          "then": {
            "properties": {
              "exactCommands": { "$ref": "#/$defs/nonEmptyArray" },
              "requiredCommandTokens": { "$ref": "#/$defs/nonEmptyArray" },
              "requiredRunnerOrPlatformTokens": { "$ref": "#/$defs/nonEmptyArray" }
            }
          }
        },
        {
          "if": { "properties": { "applicability": { "const": "N/A" } }, "required": ["applicability"] },
          "then": {
            "properties": {
              "exactCommands": { "$ref": "#/$defs/emptyArray" },
              "requiredCommandTokens": { "$ref": "#/$defs/emptyArray" },
              "requiredRunnerOrPlatformTokens": { "$ref": "#/$defs/emptyArray" }
            }
          }
        }
      ]
    }
  }
}
